#!/usr/bin/env sh
# Run lint only in workspaces with staged changes.
# Fails fast on the first failing workspace.

set -e

changed=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$changed" ]; then
  exit 0
fi

for svc in services/user-service services/chat-service services/message-service services/notification-service services/presence-service frontend; do
  if echo "$changed" | grep -q "^$svc/"; then
    echo ""
    echo "── Linting $svc ──"
    (cd "$svc" && npm run lint --silent) || {
      echo ""
      echo "✖ Lint failed in $svc. Fix the errors above and re-stage."
      exit 1
    }
  fi
done

echo ""
echo "✓ Pre-commit checks passed."
