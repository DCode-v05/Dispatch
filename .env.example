# =============================================================
# Required for all 5 backend services
# =============================================================

# Must be at least 32 random characters in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_ME_with_a_32_byte_hex_string
JWT_EXPIRATION=86400

NODE_ENV=development

# The exact origin the frontend is served from (no trailing slash, must be https:// in prod).
# Comma-separate to allow multiple origins.
FRONTEND_URL=http://localhost:3000

# =============================================================
# PostgreSQL (user-service only)
# =============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=chatadmin
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=chatplatform
POSTGRES_POOL_MAX=5
POSTGRES_SSL=false

# =============================================================
# MongoDB (chat-service + message-service)
# =============================================================
MONGODB_URI=mongodb://chatadmin:REPLACE_ME@mongodb:27017/chatplatform?authSource=admin
MONGODB_POOL_MAX=10

# =============================================================
# Redis (notification-service + presence-service)
# =============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME

# =============================================================
# RabbitMQ (all 5 backend services)
# =============================================================
RABBITMQ_URL=amqp://chatadmin:REPLACE_ME@rabbitmq:5672
