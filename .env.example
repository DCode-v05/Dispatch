# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=86400

# PostgreSQL (User Service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=chatadmin
POSTGRES_PASSWORD=chatpass123
POSTGRES_DB=chatplatform

# MongoDB (Chat + Message Services)
MONGODB_URI=mongodb://chatadmin:chatpass123@mongodb:27017/chatplatform?authSource=admin

# Redis (Notification + Presence Services)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=chatpass123

# RabbitMQ
RABBITMQ_URL=amqp://chatadmin:chatpass123@rabbitmq:5672

# Internal API Key (service-to-service)
INTERNAL_API_KEY=internal-secret-key
